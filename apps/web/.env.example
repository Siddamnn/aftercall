# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after changing it.

# The tenant's aftercall API key, for local dev only. The dev server adds it to /api requests,
# so it never reaches the browser. Never name it VITE_*: those are compiled into the page, and
# the build refuses to start with a VITE_ key or secret. From apps/backend:
#   ../../.venv/Scripts/python -m aftercall.cli create-tenant "My Company"
AFTERCALL_API_KEY=

# Where the dev server proxies /api to (the backend). Default: http://127.0.0.1:8000
# API_PROXY_TARGET=http://127.0.0.1:8000

# Call the API directly instead of through the proxy (needs CORS on the backend). Leave it unset in
# production: the page then calls /api on its own origin, which Firebase Hosting rewrites to Cloud Run.
# VITE_API_URL=

# true = run on the in-memory mock, no backend needed. Add ?price=0.5 to preview costs.
# VITE_API_MOCK=true

# The product's domain, for workspace addresses (aftercall.app/sunrise-clinic), links, robots.txt
# and the sitemap. Public. Keep it the same as the backend's APP_HOST. Default: aftercall.app
# VITE_APP_HOST=aftercall.app

# Billing is off in this build (no cards, top-ups or plans). `on` shows the pricing, plan and credits
# screens for a backend that charges. Default: off.
# VITE_BILLING=off

# Firebase Authentication (Google sign-in). Public web identifiers, not secrets: they are compiled
# into the page on purpose (the build guard allows exactly these). Firebase console > Project
# settings > Your apps > Web app. With these unset, the app signs in as before: the dev proxy's
# AFTERCALL_API_KEY, or the mock.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
