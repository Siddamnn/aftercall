# Copy to .env and fill in. Never commit .env. On Cloud Run these come from deploy.sh and Secret Manager.

# Jev (TypeSafe) — https://console.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Gemini (Ask alteria, call recordings). Locally an AI Studio key; on Cloud Run Vertex AI is used.
GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_MODELS_SIMPLE=gemini-3.5-flash-lite
# GEMINI_MODELS_STANDARD=gemini-3.8-flash
# GEMINI_MODELS_COMPLEX=gemini-3.1-pro-preview,gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash

# Records: memory (local, gone on restart) or firestore (needs GCP_PROJECT and credentials).
STORE_BACKEND=memory
# GCP_PROJECT=
# Memory store: a demo workspace with this API key is created at startup (start.sh generates it).
DEV_API_KEY=

# Recordings bucket; without it they're kept in ./.uploads
# GCS_BUCKET=
# Cloud Tasks; without a queue, calls run in-process
# CLOUD_TASKS_QUEUE=
# CLOUD_TASKS_LOCATION=asia-south1
# TASK_SERVICE_URL=
# TASK_INVOKER_EMAIL=
# Firebase Authentication project (defaults to GCP_PROJECT); without it only API keys sign in
# FIREBASE_PROJECT_ID=

# The product's domain (invite links, workspace addresses); same as the web's VITE_APP_HOST
# APP_HOST=aftercall.app
# Browser origins allowed to call the API directly, comma-separated (dev uses Vite's proxy)
# CORS_ORIGINS=

# Calls over this many tokens are flagged over_limit and not sent to Jev
TOKEN_BUDGET=30000
# At most this many signals per Jev request; more are split
MAX_SIGNALS_PER_REQUEST=15
DEFAULT_REVIEW_THRESHOLD=0.6
